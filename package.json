{
  "name": "dsh-answer-card",
  "version": "0.1.0",
  "description": "macOS floating card for DeepSeek Harness: answer questions, approve tool calls and jump back to DSH from an always-on-top window.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "helper",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "macos",
    "notification",
    "approval",
    "floating-window"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Asthestarsfalll",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asthestarsfalll/dsh-answer-card.git"
  },
  "homepage": "https://github.com/Asthestarsfalll/dsh-answer-card#readme",
  "bugs": {
    "url": "https://github.com/Asthestarsfalll/dsh-answer-card/issues"
  }
}
